# Gemini server key. Create this in Google AI Studio and add it only to the
# hosting provider's server environment; never put a Mapbox token here.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
# Optional overrides. Retired Gemini 2.0 model names are automatically mapped
# to gemini-3.8-flash by the server.
GEMINI_MODEL="gemini-3.8-flash"
ROAD_SCANNER_GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Public Configuration (Client-side)
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_AUTH_DOMAIN"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"

# Optional map tile API template. Keep {z}, {x}, and {y}; add a provider key only
# in your local .env, never in source control. CARTO is used when omitted.
VITE_MAP_TILE_URL="https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png"

# Optional Mapbox public access token for the Road Risk Intelligence map.
VITE_MAPBOX_ACCESS_TOKEN="YOUR_MAPBOX_PUBLIC_TOKEN"
