rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && (
        (request.auth.token.role == role) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         getUserData().role == role)
      );
    }

    function isAdmin() {
      return hasRole('admin') || 
             (isAuthenticated() && request.auth.token.email.matches('.*admin.*'));
    }

    function isMunicipal() {
      return isAdmin() || hasRole('municipal') ||
             (isAuthenticated() && (
               request.auth.token.email.matches('.*@.*\\.gov\\.in$') ||
               request.auth.token.email.matches('.*officer.*') ||
               request.auth.token.email.matches('.*municipal.*')
             ));
    }

    function isFieldTeam() {
      return hasRole('field_team') || isMunicipal() ||
             (isAuthenticated() && (
               request.auth.token.email.matches('.*field.*') ||
               request.auth.token.email.matches('.*crew.*')
             ));
    }

    // Default deny all unhandled paths
    match /{document=**} {
      allow read, write: if false;
    }

    // User Profiles (citizen, municipal, field_team, admin)
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Field Teams Directory
    match /fieldTeams/{teamId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isMunicipal();
    }

    match /teams/{teamId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isMunicipal();
    }

    // Citizen Incident Reports & Dispatch (Public safety reports readable by public)
    match /reports/{reportId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.reporterEmail == request.auth.token.email ||
        isAdmin() || isMunicipal() || isFieldTeam()
      );
      allow update: if isAuthenticated() && (
        isMunicipal() || isFieldTeam() || isAdmin() ||
        resource.data.userId == request.auth.uid
      );
      allow delete: if isAdmin() || isMunicipal();
    }

    // AI Road Scans
    match /roadScans/{scanId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isMunicipal() || isAdmin();
    }

    // Municipal Command Center Actions
    match /municipalActions/{actionId} {
      allow read: if true;
      allow create, update: if isMunicipal() || isAdmin();
      allow delete: if false;
    }

    // Platform Audit Logs (Admin immutable ledger)
    match /auditLogs/{auditId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // User Notifications
    match /notifications/{notificationId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        isAdmin() || isMunicipal() || 
        resource.data.recipientEmail == request.auth.token.email
      );
    }

    // Incident Status History Audit Trail (Immutable)
    match /history/{historyId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Citizen Rewards & Token Ledger
    match /rewards/{rewardId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }
  }
}




